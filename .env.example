# ==============================================================================
# Focus: AI News Curation Pipeline - Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="AI News Curation Pipeline"
API_V1_STR="/api/v1"
DEBUG=True

# SQLite Database (Local temporary storage for drafts and AI metadata)
DATABASE_URL="sqlite:///./focus.db"

# Celery & Redis Task Queue
REDIS_URL="redis://localhost:6379/0"

# Media Storage
STORAGE_TEMP_DIR="./storage/temp"

# Search & Visual Geolocation API (SerpApi - https://serpapi.com/manage-api-key)
SERPAPI_API_KEY=""

# Active LLM Provider ("nvidia_nemotron" or "gemini")
DEFAULT_LLM_PROVIDER="nvidia_nemotron"

# NVIDIA NIM API (Free trial: https://build.nvidia.com/nvidia/nemotron-3-ultra-550b-a55b)
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="nvidia/nemotron-3-ultra-550b-a55b"

# AI Engine (Google Gemini / Antigravity SDK)
GEMINI_API_KEY=""

# Live Flutter/Laravel App Webhook Integration (STRICT ISOLATION - HTTP Only)
LARAVEL_API_URL="https://your-laravel-domain.com/api"
LARAVEL_API_TOKEN="your_secure_bearer_token"

# Autonomous Publishing Mode
# Set to True for fully autonomous pipeline (no human review — articles go straight to production)
# Set to False (default) for human-in-the-loop review via Streamlit Editorial Studio
AUTO_PUBLISH=False

# Streamlit Frontend settings
FASTAPI_BASE_URL="http://127.0.0.1:8000"

